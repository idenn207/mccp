{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "MAX_OUTPUT_TOKENS": "8000",
    "MAX_THINKING_TOKENS": "10000",
    "ENABLE_TOOL_SEARCH": "auto:3",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "100000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50",
    "MCCP_RECEIPT_GATE_MODE": "soft",
    "MCCP_RECEIPT_DEBUG": "on",
    "MCCP_GATE_ROUND_CAP": "1",
    "MCCP_GOAL_FEATURE": "available",
    "MCCP_ULTRACODE_FEATURE": "available",
    "MCCP_PLAN_REVIEW": "multi-agent",
    "MCCP_PLAN_REVIEW_ROLES_MIN": "1",
    "MCCP_SANTA_ROUND_CAP": "5",
    "MCCP_SANTA_SEVERITY_GATE": "enforce",
    "MCCP_WORK_PARALLEL_MAX": "10",
    "MCCP_MULTI_SESSION_SCAN": "on",
    "MCCP_HANDOFF_THRESHOLDS_USD": "500,800,1000",
    "MCCP_DISABLED_HOOKS": "pre:bash:gateguard-fact-force,pre:edit-write:gateguard-fact-force",
    "MCCP_SESSION_START_CONTEXT": "on",
    "MCCP_SESSION_RETENTION_DAYS": "10"
  },
  "model": "opus",
  "outputStyle": "default",
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "latest"
}
