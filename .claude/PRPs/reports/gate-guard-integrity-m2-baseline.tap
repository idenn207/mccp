# prepare-single requires --controller-session <uuid>
# --controller-session must be a UUID
# [mccp:renderer-trigger] reason=envelope-write SKIP render in-flight (EEXIST)
# mark requires --status <ok|failure|timeout|crashed>
# [mccp:renderer-trigger] reason=envelope-write SKIP render in-flight (EEXIST)
# reconcile requires --args-file <path>
# usage: dispatch-cli <prepare-single|prepare-fleet|emit-workflow-args|reconcile|merge|mark|seed-envelope|collect-worktrees|merge-apply|rollback-apply|verify-focus|verify-decide> [options]
#   prepare-single      --plan <path> --controller-session <uuid> [--subagent <type>] [--parent-cwd <path>] [--dry-run]
#   prepare-fleet       --plan <path> --controller-session <uuid> --partitions-file <json> [--subagent <type>] [--parent-cwd <path>] [--dry-run]
#   emit-workflow-args  --prepare-file <path> [--min-remaining <n>]
#   reconcile           --args-file <path> [--envelope <abs>] [--result-file <path>] [--from-envelope] [--repo-root <path>]
#                       (fleet) --args-file <fleet emit> [--results-dir <dir>] [--from-envelope] [--actual-files-map <json>] [--worktree-map <json>] [--shared-allowlist <csv>] [--repo-root <path>]
#   merge               --envelope <path>
#   mark                --envelope <path> --status <ok|failure|timeout|crashed> [--receipts <csv>] [--findings-file <path>] [--next-action <text>]
#   seed-envelope       --envelope <repo-rel> --dispatch-id <uuid> --controller-session <uuid> [--subagent <type>]  (M4)
#   collect-worktrees   --dispatch-ids <csv|json> | --dispatch-ids-file <path> [--repo-root <path>] [--out <path>]  (M3)
#   merge-apply         --worktree-map <path> [--partitions-file <json>] [--shared-allowlist <csv>] [--repo-root <path>] [--patches-out <path>] [--dry-run]  (M3)
#   rollback-apply      --patches-file <path> [--repo-root <path>]  (M3)
#   verify-focus        --base <ref> [--changed-files <csv> | --changed-files-file <path>] [--partitions-file <json>] [--findings-file <json>]  (M3)
#   verify-decide       --codex-json <path> [--mode off|warn|enforce] [--verdict <enum>] [--rounds <N>]  (M3)
