          "PostSession",
          "AgentStart",
          "AgentStop",
          "PreSubmit",
          "PostSubmit",
          "ToolUse",
          "Error",
          "Startup",
          "Shutdown",
          "SessionStarted",
          "SessionEnded",
          "UserPromptSubmitted",
          "PreExec",
          "PostExec"
        ],
        "mccp_events_present": [
          "PreToolUse",
          "PostToolUse",
          "SessionStart",
          "SessionEnd",
          "PreCompact",
          "Stop"
        ],
        "mccp_events_absent": [
          "UserPromptExpansion",
          "PostToolUseFailure"
        ],
        "limitation": "this enumerates what the CONFIG STRUCT accepts, which is a superset of what actually dispatches; only 6 of the 10 were observed firing"
      }
    },
    {
      "id": "dispatch-fired",
      "codex_version": "0.153.4",
      "trust_mode": "bypassed",
      "question": "do hooks actually dispatch, and in what order (A1/A2/A6)",
      "method": "probe hook registered on 15 names; one `codex exec` turn that used a tool",
      "result": {
        "fired_in_order": [
          "SessionStart",
          "UserPromptSubmit",
          "PreToolUse",
          "PostToolUse",
          "Stop",
          "SessionEnd"
        ],
        "registered_but_never_fired": [
          "PreCompact",
          "PostCompact",
          "SubagentStart",
          "SubagentStop"
        ],
        "has_tool_name": true,
        "note": "payload shape is isomorphic to the Claude Code hook protocol; receipt-skill.js:152 tool_name requirement is satisfied"
      }
    },
