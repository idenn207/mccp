  "runs": [
    {
      "id": "entrypoint-selection",
      "codex_version": "0.153.4",
      "question": "which Codex entrypoint actually parses [hooks] (Task 2-0)",
      "method": "register a bogus event name, run each candidate, see which rejects it",
      "result": {
        "parses_hooks": [
          "exec"
        ],
        "does_not_parse": [
          "doctor",
          "plugin list",
          "features list",
          "debug prompt-input",
          "sandbox"
        ],
        "dispatches_hooks": [
          "exec"
        ],
        "note": "no non-model entrypoint parses or dispatches hooks, so DD9 fallback to codex exec was required; each exec turn cost ~3.1k tokens"
      }
    },
    {
      "id": "hooks-config-schema",
      "codex_version": "0.153.4",
      "question": "what shape does config.toml [hooks] take",
      "method": "type-error reverse engineering — feed wrong types and read the serde error",
      "result": {
        "hooks": "struct HooksToml (unknown fields SILENTLY IGNORED)",
        "event_value": "sequence of struct MatcherGroup",
        "matcher_group": "{ matcher: string, hooks: [HookHandlerConfig] } — every field optional",
        "handler": "internally tagged enum; variants command | mcp_tool | prompt | agent",
        "command_variant": "field `command` REQUIRED, type STRING (not an array)",
        "working_form": "<Event> = [ { matcher = \"*\", hooks = [ { type = \"command\", command = \"<cmd>\" } ] } ]",
        "trap": "`<Event> = [ { command = [...] } ]` PARSES CLEANLY and yields an empty matcher group with zero hooks — a valid config with zero dispatch and no warning"
      }
    },
    {
      "id": "event-enum",
      "codex_version": "0.153.4",
      "question": "which event names exist in HooksToml (A2)",
      "method": "`<Event> = [ 5 ]` — a known field is type-checked (invalid type: expected struct MatcherGroup), an unknown one is silently ignored",
      "result": {
        "fields_present": [
          "UserPromptSubmit",
          "PreToolUse",
          "PostToolUse",
          "SessionStart",
          "SessionEnd",
          "Stop",
          "PreCompact",
          "PostCompact",
          "SubagentStart",
          "SubagentStop"
        ],
        "fields_absent_of_29_probed": [
